{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus instance scraping SOMA's /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Auth-focused dashboard over soma_auth_failures_total{reason}. The REST layer only labels auth failures by reason (invalid_token, expired_token, insufficient_perm, missing_credentials, revoked_token); bundle/instance slicing comes from the $instance template variable against the FastAPI http_requests_total series.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Auth failures (last 5m)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 5},
      "description": "Total auth failures observed in the last 5 minutes, summed across all reasons and instances.",
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 10, "color": "red"}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(increase(soma_auth_failures_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "failures",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Revoked-token hits (last 5m)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 5},
      "description": "Failures where reason=\"revoked_token\" — these indicate real attackers replaying cancelled tokens, not user error.",
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 1, "color": "red"}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(increase(soma_auth_failures_total{reason=\"revoked_token\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "revoked hits",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Auth success rate",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 5},
      "description": "Successful request fraction over the last 5 minutes. Uses FastAPI's http_requests_total as the denominator and subtracts soma_auth_failures_total — approximates 'percent of traffic that made it past the auth layer'.",
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 0.95, "color": "yellow"},
              {"value": 0.99, "color": "green"}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "1 - ( sum(rate(soma_auth_failures_total{instance=~\"$instance\"}[5m])) / clamp_min(sum(rate(http_requests_total{instance=~\"$instance\",handler!=\"/metrics\"}[5m])), 1) )",
          "legendFormat": "success",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Auth failures by reason",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 5, "w": 24, "h": 9},
      "description": "Stacked per-reason failure rate. invalid_token / missing_credentials typically dominate during normal rollout churn; expired_token is a sign of clock drift or refresh issues; insufficient_perm and revoked_token deserve investigation.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 25,
            "stacking": {"mode": "normal", "group": "A"}
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (reason) (rate(soma_auth_failures_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Failure counts by reason (last 1h)",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 7},
      "description": "Raw failure counts bucketed by reason over the last hour. Sorted descending so whichever reason is causing the current pain lands at the top.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"align": "auto", "displayMode": "color-text"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 10, "color": "yellow"},
              {"value": 100, "color": "red"}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [{"id": "displayName", "value": "Failures (1h)"}]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {"show": true, "reducer": ["sum"], "fields": ""}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (reason) (increase(soma_auth_failures_total{instance=~\"$instance\"}[1h]))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true},
            "indexByName": {"reason": 0, "Value": 1},
            "renameByName": {"reason": "Reason"}
          }
        },
        {"id": "sortBy", "options": {"fields": {}, "sort": [{"field": "Value", "desc": true}]}}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["soma", "auth", "security"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Prometheus data source",
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "type": "query",
        "label": "Instance",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": {"query": "label_values(soma_loaded_bundles, instance)", "refId": "StandardVariableQuery"},
        "definition": "label_values(soma_loaded_bundles, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": false, "text": "All", "value": "$__all"},
        "sort": 1
      },
      {
        "name": "bundle",
        "type": "query",
        "label": "Bundle (informational only — auth metrics are not bundle-labelled)",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": {"query": "label_values(soma_entries{instance=~\"$instance\"}, bundle)", "refId": "StandardVariableQuery"},
        "definition": "label_values(soma_entries{instance=~\"$instance\"}, bundle)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": false, "text": "All", "value": "$__all"},
        "sort": 1
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
  },
  "timezone": "browser",
  "title": "SOMA · Auth",
  "uid": "soma-auth",
  "version": 1,
  "weekStart": ""
}
