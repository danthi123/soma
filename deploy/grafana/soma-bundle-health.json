{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus instance scraping SOMA's /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "USE-method dashboard over the memory-layer substrate: WAL throughput, consolidation cost, bundle size and retrieve-latency distribution. The consolidation-duration panel accepts either soma_consolidate_seconds (shipped in Phase 3) or soma_compaction_seconds (Phase 8); whichever metric is present renders, the other contributes an empty series.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "WAL append rate by op",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "description": "soma_wal_append_total rate, split by op label (store / forget / update_metadata). Sustained high rates on 'forget' are worth investigating — they typically indicate churn or a misconfigured TTL.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 15,
            "stacking": {"mode": "normal", "group": "A"}
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (op) (rate(soma_wal_append_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{op}}"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(soma_wal_flush_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "flush p95 (s)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Consolidation duration p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "description": "p95 of per-consolidate wall-clock time. References both soma_consolidate_seconds (Phase 3) and soma_compaction_seconds (Phase 8) so the panel keeps working regardless of which metric the running build exposes. Either series simply renders empty if absent.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(soma_consolidate_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "consolidate p95"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(soma_compaction_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "compaction p95 (phase 8)"
        },
        {
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(soma_consolidate_total[5m]))",
          "legendFormat": "consolidations/s (scale: right axis)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Live entries per bundle",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "description": "soma_entries gauge per selected bundle. Good as a utilization signal — sudden drops usually mean a forget() run; slow climbs are normal ingest.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "soma_entries{bundle=~\"$bundle\",instance=~\"$instance\"}",
          "legendFormat": "entries · {{bundle}}"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "soma_faiss_index_size{bundle=~\"$bundle\",instance=~\"$instance\"}",
          "legendFormat": "faiss · {{bundle}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total live entries (selected bundles)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 4},
      "description": "Sum of soma_entries over the filtered bundle set. A coarse capacity gauge when planning shard splits.",
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "blue"},
              {"value": 100000, "color": "yellow"},
              {"value": 1000000, "color": "red"}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(soma_entries{bundle=~\"$bundle\",instance=~\"$instance\"})",
          "legendFormat": "entries",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Peer reloads (soma_reload_total)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 4},
      "description": "reload_if_stale() invocations that picked up peer-committed records. High rates during multi-writer workloads are expected; zero values on a single-writer deploy are the healthy resting state.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (bundle) (rate(soma_reload_total{bundle=~\"$bundle\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{bundle}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Retrieve latency heatmap",
      "type": "heatmap",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 10},
      "description": "Distribution of soma_retrieve_latency_seconds buckets over time. Colour intensity maps to the count of retrieves landing in each latency bucket; the saturation band rising over time is the canonical 'something is getting slower' signal.",
      "options": {
        "calculate": false,
        "cellGap": 1,
        "cellValues": {"decimals": 0},
        "color": {"exponent": 0.5, "fill": "dark-orange", "mode": "scheme", "scale": "exponential", "scheme": "Oranges", "steps": 64},
        "exemplars": {"color": "rgba(255,0,255,0.7)"},
        "filterValues": {"le": 1e-9},
        "legend": {"show": true},
        "rowsFrame": {"layout": "auto"},
        "tooltip": {"show": true, "yHistogram": true},
        "yAxis": {"axisPlacement": "left", "reverse": false, "unit": "s"}
      },
      "fieldConfig": {
        "defaults": {"custom": {"scaleDistribution": {"type": "linear"}, "hideFrom": {"tooltip": false, "viz": false, "legend": false}}},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (le) (rate(soma_retrieve_latency_seconds_bucket{bundle=~\"$bundle\",instance=~\"$instance\"}[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["soma", "use", "bundle", "storage"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Prometheus data source",
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "type": "query",
        "label": "Instance",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": {"query": "label_values(soma_loaded_bundles, instance)", "refId": "StandardVariableQuery"},
        "definition": "label_values(soma_loaded_bundles, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": false, "text": "All", "value": "$__all"},
        "sort": 1
      },
      {
        "name": "bundle",
        "type": "query",
        "label": "Bundle",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": {"query": "label_values(soma_entries{instance=~\"$instance\"}, bundle)", "refId": "StandardVariableQuery"},
        "definition": "label_values(soma_entries{instance=~\"$instance\"}, bundle)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": false, "text": "All", "value": "$__all"},
        "sort": 1
      }
    ]
  },
  "time": {"from": "now-3h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
  },
  "timezone": "browser",
  "title": "SOMA · Bundle health (USE)",
  "uid": "soma-bundle-health",
  "version": 1,
  "weekStart": ""
}
