{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus instance scraping SOMA's /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "RED-method overview of SOMA's REST surface: request rate, error rate and latency across /retrieve, /store, /store_batch, /forget, /consolidate. See docs/observability.md for the underlying metric definitions.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Total requests (5m)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "description": "Sum of SOMA operation counters over the last 5 minutes. Useful as a liveness signal.",
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(increase(soma_retrieve_total{bundle=~\"$bundle\"}[5m])) + sum(increase(soma_store_total{bundle=~\"$bundle\"}[5m])) + sum(increase(soma_store_batch_total{bundle=~\"$bundle\"}[5m])) + sum(increase(soma_forget_total{bundle=~\"$bundle\"}[5m])) + sum(increase(soma_consolidate_total[5m]))",
          "legendFormat": "requests",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Retrieve p95 latency",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "description": "p95 of soma_retrieve_latency_seconds across selected bundles over the last 5 minutes.",
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 0.1, "color": "yellow"},
              {"value": 0.5, "color": "red"}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(soma_retrieve_latency_seconds_bucket{bundle=~\"$bundle\"}[5m])))",
          "legendFormat": "p95",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Auth failure rate (5m)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "description": "Rate of soma_auth_failures_total over the last 5 minutes. Drill into the Auth dashboard to see reasons.",
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 0.1, "color": "yellow"},
              {"value": 1, "color": "red"}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(soma_auth_failures_total[5m]))",
          "legendFormat": "failures/s",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Slowest routes (p95)",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "description": "Top FastAPI routes by p95 duration, computed from http_request_duration_seconds_bucket. Shown collapsed — expand by dragging the handle if you need more room.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"align": "auto", "displayMode": "color-text"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 0.1, "color": "yellow"},
              {"value": 0.5, "color": "red"}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [{"id": "displayName", "value": "p95 latency"}]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {"show": false, "reducer": ["sum"], "fields": ""}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "topk(10, histogram_quantile(0.95, sum by (handler, le) (rate(http_request_duration_seconds_bucket{instance=~\"$instance\",handler!=\"/metrics\"}[5m]))))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true},
            "indexByName": {"handler": 0, "Value": 1},
            "renameByName": {"handler": "Route"}
          }
        },
        {"id": "sortBy", "options": {"fields": {}, "sort": [{"field": "Value", "desc": true}]}}
      ]
    },
    {
      "id": 5,
      "title": "Request rate by route",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "description": "Per-route request rate across the SOMA operation counters.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "stacking": {"mode": "none", "group": "A"}
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(soma_retrieve_total{bundle=~\"$bundle\"}[5m]))",
          "legendFormat": "retrieve"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(soma_store_total{bundle=~\"$bundle\"}[5m]))",
          "legendFormat": "store"
        },
        {
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(soma_store_batch_total{bundle=~\"$bundle\"}[5m]))",
          "legendFormat": "store_batch"
        },
        {
          "refId": "D",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(soma_forget_total{bundle=~\"$bundle\"}[5m]))",
          "legendFormat": "forget"
        },
        {
          "refId": "E",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(soma_consolidate_total[5m]))",
          "legendFormat": "consolidate"
        }
      ]
    },
    {
      "id": 6,
      "title": "Retrieve latency percentiles (p50/p95/p99)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "description": "Quantiles derived from soma_retrieve_latency_seconds_bucket.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.50, sum by (le) (rate(soma_retrieve_latency_seconds_bucket{bundle=~\"$bundle\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(soma_retrieve_latency_seconds_bucket{bundle=~\"$bundle\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.99, sum by (le) (rate(soma_retrieve_latency_seconds_bucket{bundle=~\"$bundle\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "title": "Store / store_batch rate by bundle",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "description": "Per-bundle store + store_batch rate. store_batch fires once per batch call, not per item — expect it to be smaller than store for high-throughput ingest.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "stacking": {"mode": "normal", "group": "A"}
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (bundle) (rate(soma_store_total{bundle=~\"$bundle\"}[5m]))",
          "legendFormat": "store · {{bundle}}"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (bundle) (rate(soma_store_batch_total{bundle=~\"$bundle\"}[5m]))",
          "legendFormat": "store_batch · {{bundle}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "5xx error rate by FastAPI route",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "description": "Error rate from prometheus-fastapi-instrumentator's http_requests_total. 5xx only; 401/403 live on the Auth dashboard.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 20,
            "stacking": {"mode": "normal", "group": "A"}
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (handler) (rate(http_requests_total{status=~\"5..\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{handler}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["soma", "red", "overview"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Prometheus data source",
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "type": "query",
        "label": "Instance",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": {"query": "label_values(soma_loaded_bundles, instance)", "refId": "StandardVariableQuery"},
        "definition": "label_values(soma_loaded_bundles, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": false, "text": "All", "value": "$__all"},
        "sort": 1
      },
      {
        "name": "bundle",
        "type": "query",
        "label": "Bundle",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": {"query": "label_values(soma_entries{instance=~\"$instance\"}, bundle)", "refId": "StandardVariableQuery"},
        "definition": "label_values(soma_entries{instance=~\"$instance\"}, bundle)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": false, "text": "All", "value": "$__all"},
        "sort": 1
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
  },
  "timezone": "browser",
  "title": "SOMA · Overview (RED)",
  "uid": "soma-overview",
  "version": 1,
  "weekStart": ""
}
