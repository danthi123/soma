# Patterns to ignore when building packages.
# Files and directories matching patterns here will be excluded.
.DS_Store
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# CI test values — not shipped in chart package
../ci/
